# Backend environment template — copy to .env and fill in real values.
# .env is gitignored; this .env.example IS committed (per project rubric).

# Server
PORT=4000
NODE_ENV=development

# Session signing secret — replace with a long random string in real use.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# CORS / cookies — the frontend origin allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file (recreated from db/schema.sql; gitignored).
DATABASE_PATH=./db/app.db

# Uploaded media directory + public base URL used to build absolute image URLs.
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:4000
